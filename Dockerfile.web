# The web app: a static site served by Nginx.
#
# Multi-stage build: stage 1 has Node and all the build tools; stage 2 copies only the built
# files into a small Nginx image, so the final image has no Node, no source and no node_modules.

# ---- Stage 1: build ----
FROM node:24-alpine AS build
WORKDIR /app
# Copy the dependency list first: Docker caches this layer, so `npm ci` reruns only when it changes.
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- Stage 2: serve ----
FROM nginx:1.28-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
