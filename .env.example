# The AI tutor reads its Anthropic API key from Vault at startup.
# `npm run vault:start` fills in VAULT_ADDR and VAULT_TOKEN for you; then store the key with
# `npm run vault:put-key`. VAULT_TOKEN is a read-only token for one secret, not the root token.
VAULT_ADDR=
VAULT_TOKEN=

# Fallback if Vault isn't running. Leave empty to keep the key out of this file.
ANTHROPIC_API_KEY=

TUTOR_PORT=8787
